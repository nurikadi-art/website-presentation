[
  {
    "type": "importText",
    "config": {
      "path": "C:\\AdsPower\\threads_data.txt",
      "variable": "all_tweets",
      "remark": "Load all tweets from file (each line = one tweet, use === to separate threads)"
    }
  },
  {
    "type": "randomGet",
    "config": {
      "content": "all_tweets",
      "variable": "current_thread",
      "remark": "Get one thread randomly (for multi-profile batch)"
    }
  },
  {
    "type": "executeJavaScript",
    "config": {
      "code": "var tweets = '${current_thread}'.split('|||'); window.tweets = tweets; window.tweetCount = tweets.length; return tweets.length;",
      "variable": "tweet_count",
      "remark": "Parse thread into individual tweets (split by |||)"
    }
  },
